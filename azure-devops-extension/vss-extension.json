{
  "manifestVersion": 1,
  "id": "ado-work-map-boards",
  "publisher": "DasCondor",
  "version": "1.2.0",
  "name": "ADO Work Map",
  "description": "Two hubs in Boards: a Work Map of epics to tasks, sprints, changes, repos and links, and Sprint planning as a team - capacity, days off, poker and a plan you can save back.",
  "public": false,
  "galleryFlags": ["Preview"],
  "categories": ["Azure Boards"],
  "tags": ["work items", "epics", "features", "sprints", "delivery map", "dependencies", "pull requests", "commits", "heatmap", "visualization"],
  "targets": [{"id": "Microsoft.VisualStudio.Services.Cloud"}],
  "icons": {"default": "images/icon.png"},
  "content": {
    "details": {"path": "overview.md"},
    "license": {"path": "LICENSE.txt"}
  },
  "links": {
    "repository": {"uri": "https://github.com/DasCondor/ado-work-map-extension"},
    "support": {"uri": "https://github.com/DasCondor/ado-work-map-extension/issues"},
    "license": {"uri": "https://github.com/DasCondor/ado-work-map-extension/blob/main/LICENSE"}
  },
  "repository": {"type": "git", "uri": "https://github.com/DasCondor/ado-work-map-extension"},
  "branding": {"color": "#0f62fe", "theme": "dark"},
  "scopes": ["vso.work", "vso.work_write", "vso.code", "vso.project", "vso.analytics"],
  "files": [
    {"path": "dist", "addressable": true},
    {"path": "images", "addressable": true}
  ],
  "contributions": [
    {
      "id": "work-map-hub",
      "type": "ms.vss-web.hub",
      "description": "Delivery map, sprints, changes, maps and spider web for this project",
      "targets": ["ms.vss-work-web.work-hub-group"],
      "properties": {
        "name": "Work Map",
        "order": 100,
        "uri": "dist/hub.html"
      }
    },
    {
      "id": "sprint-planning-hub",
      "type": "ms.vss-web.hub",
      "description": "Plan a sprint as a team: capacity and days off, planning poker, assigned work against capacity, and save the plan to Azure DevOps",
      "targets": ["ms.vss-work-web.work-hub-group"],
      "properties": {
        "name": "Sprint planning",
        "order": 101,
        "uri": "dist/planning.html"
      }
    }
  ]
}
